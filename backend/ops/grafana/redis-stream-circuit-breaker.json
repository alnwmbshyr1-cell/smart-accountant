{
  "uid": "smart-accountant-redis-circuit",
  "title": "Smart Accountant · Redis Stream & Circuit Breaker",
  "description": "Real-time resilience dashboard for Redis Stream delivery and external dependency Circuit Breakers.",
  "tags": ["smart-accountant", "redis", "circuit-breaker", "security"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [{"name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "query": "prometheus", "refresh": 1}]},
  "annotations": {"list": [{"builtIn": 1, "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "iconColor": "#5794F2", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "panels": [
    {"id": 1, "type": "stat", "title": "Circuit state", "description": "0=closed, 1=open, 2=half-open", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "max by (dependency) (circuit_breaker_state)", "legendFormat": "{{dependency}}", "refId": "A"}], "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "CLOSED", "color": "green"}, "1": {"text": "OPEN", "color": "red"}, "2": {"text": "HALF-OPEN", "color": "yellow"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}]}, "unit": "none"}}, "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"id": 2, "type": "timeseries", "title": "Circuit rejections", "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum by (dependency) (rate(circuit_breaker_rejected_total[5m]))", "legendFormat": "{{dependency}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 15, "drawStyle": "line"}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 3, "type": "timeseries", "title": "Protected call p95 latency", "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, dependency) (rate(circuit_breaker_call_duration_seconds_bucket[5m])))", "legendFormat": "{{dependency}} p95", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 10}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 4, "type": "stat", "title": "Stream queue depth", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "max(security_webhook_queue_depth)", "legendFormat": "pending", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100}, {"color": "red", "value": 1000}]}}}, "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}},
    {"id": 5, "type": "timeseries", "title": "Redis Stream throughput", "gridPos": {"h": 8, "w": 9, "x": 6, "y": 8}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum(rate(security_webhook_received_total[5m]))", "legendFormat": "received", "refId": "A"}, {"expr": "sum(rate(security_webhook_delivery_success_total[5m]))", "legendFormat": "delivered", "refId": "B"}, {"expr": "sum(rate(security_webhook_dead_letter_total[5m]))", "legendFormat": "dead-letter", "refId": "C"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 6, "type": "timeseries", "title": "Delivery failures and retries", "gridPos": {"h": 8, "w": 9, "x": 15, "y": 8}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum by (channel, reason) (rate(security_webhook_delivery_failure_total[5m]))", "legendFormat": "failure {{channel}}/{{reason}}", "refId": "A"}, {"expr": "sum by (channel) (rate(security_webhook_retry_total[5m]))", "legendFormat": "retry {{channel}}", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 7, "type": "timeseries", "title": "Oldest pending message", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "max(security_webhook_oldest_pending_age_seconds)", "legendFormat": "age", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 60}, {"color": "red", "value": 300}]}}}, "options": {"legend": {"displayMode": "hidden"}}},
    {"id": 8, "type": "timeseries", "title": "Circuit failures", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 16}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum by (dependency, reason) (rate(circuit_breaker_failures_total[5m]))", "legendFormat": "{{dependency}}/{{reason}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 9, "type": "timeseries", "title": "Webhook delivery latency p99", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 16}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "histogram_quantile(0.99, sum by (le, channel) (rate(security_webhook_delivery_latency_seconds_bucket[5m])))", "legendFormat": "{{channel}} p99", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 12}}}, "options": {"legend": {"displayMode": "table", "placement": "bottom"}}},
    {"id": 10, "type": "table", "title": "Active circuit dependencies", "gridPos": {"h": 7, "w": 12, "x": 0, "y": 24}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "circuit_breaker_state", "format": "table", "instant": true, "legendFormat": "{{dependency}}", "refId": "A"}], "fieldConfig": {"defaults": {"custom": {"align": "auto"}}, "overrides": []}, "options": {"showHeader": true, "footer": {"show": false}}},
    {"id": 11, "type": "stat", "title": "Dead-letter rate", "gridPos": {"h": 7, "w": 12, "x": 12, "y": 24}, "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"}, "targets": [{"expr": "sum(rate(security_webhook_dead_letter_total[15m]))", "legendFormat": "DLQ/s", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.01}, {"color": "red", "value": 0.1}]}}}, "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}}
  ]
}
