# Shared
PORT=8080
GEMINI_API_KEY=replace-with-server-only-secret
GEMINI_MODEL=gemini-1.5-flash
ALLOWED_ORIGINS=

# Choose exactly one provider: firebase or supabase
AUTH_PROVIDER=supabase

# Supabase asymmetric signing keys
SUPABASE_PROJECT_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Firebase Admin SDK
# AUTH_PROVIDER=firebase
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Prefer workload identity / application default credentials in production.
# For local-only use, keep this JSON outside Git and inject it as a secret:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
